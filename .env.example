# =============================================================================
# STACK (intended production shape)
# =============================================================================
#   Frontend : React (Vite)     →  client/     →  http://localhost:5173
#   Backend  : Node.js         →  server/     →  http://localhost:4000
#   Database : MongoDB Atlas (cloud) OR docker-compose.yml (local)
#
# Local Mongo:
#   docker compose up -d
#
# MongoDB Atlas (new cluster):
#   1. Atlas → Database → Connect → Drivers → copy URI (mongodb+srv://...)
#   2. Replace <password> with your DB user password; URL-encode special chars (@ → %40).
#   3. Atlas → Network Access → allow your IP (or 0.0.0.0/0 for testing only).
#   4. Set MONGODB_URI in server/.env and/or repo-root .env (server loads both).
#   DB/collection below are created on first write if they do not exist.
#   Compass: paste the same MONGODB_URI. Python scraper reads server/.env then repo-root .env.
# =============================================================================

# MongoDB — prefer server/.env for Atlas URI (Node loads server/.env first).
# Atlas example (replace USER/PASSWORD; path = DB name): .../ransomware_india?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=ransomware_india
MONGODB_ATTACKS_COLLECTION=attacks

# Node API (copy vars into server/.env or export before `npm start`)
PORT=4000
POLL_MS=15000
SCRAPE_HOOK_SECRET=

# --- AI providers (server-side only; put real keys in server/.env) ------------
# Google AI Studio (Gemini) → POST /api/analyse (victim hub + JSON chart context)
# Groq → POST /api/live/stream-analytics (Live Feed streaming NDJSON)
# See REFERENCE.md and server/.env.example for variable names.

# If true, Node exits when Mongo is unreachable (no JSON fallback). Optional.
# REQUIRE_MONGO=false

# Python scraper — optional webhook after each run
NODE_SCRAPE_HOOK=http://127.0.0.1:4000/hooks/scrape-complete
# SCRAPE_HOOK_SECRET=  (same value as server, if you secure the hook)

# Source site (India victim listing)
RANSOMWARE_BASE=https://www.ransomware.live

# --- Vite client (optional client/.env) --------------------------------------
# VITE_KPI_COMPARE_YEAR=2025   # override dashboard YoY; default = latest year in dataset

# --- Dev-only fallback (no Mongo) -------------------------------------------
# If Mongo is down, Node can still read server/data/attacks.json and the
# scraper can write that file. For production, run Mongo and ignore this path.
# DATA_FILE=
