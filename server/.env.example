# Copy to server/.env — never commit real passwords (server/.env is gitignored).



# --- MongoDB Atlas (Compass + Node + scraper) ---------------------------------

# After connecting: open database **ransomware_india** (not admin/config/local). First read **collection _COMPASS_READ_ME** doc START_HERE — auto-created by the Node API on connect.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ransomware_india?retryWrites=true&w=majority

MONGODB_DB=ransomware_india

# Victim rows from scraper (default: attacks). Legacy: MONGODB_COLLECTION=india_attacks still read if this is unset.

MONGODB_ATTACKS_COLLECTION=attacks

# Dashboard: omit READ_INTEL_FROM_MONGO or set false = in-memory cache from POST /api/intel/refresh (login). Python still upserts Mongo for maintenance. true = legacy GET /api/attacks reads from Mongo.

# READ_INTEL_FROM_MONGO=true

# Seconds between full scraper runs when cache already has rows (0 = every refresh).

# INTEL_REFRESH_COOLDOWN_SEC=120

# PYTHON=python

# User accounts (register / login); documents hold bcrypt passwordHash only — never plain text

# MONGODB_USERS_COLLECTION=users

# JWT for signed sessions (set a long random string in production)

# JWT_SECRET=change-me-to-a-long-random-secret

# JWT_EXPIRES_IN=7d
# Must be a timespan jwt accepts (e.g. 7d, 12h, 3600). Invalid values fall back to 7d on startup.

# Optional: exit Node if Mongo is down (no attacks.json fallback)

# REQUIRE_MONGO=true



# Optional: Python scraper pings this URL after Mongo write so Socket.io refreshes the React app

# NODE_SCRAPE_HOOK=http://127.0.0.1:4000/hooks/scrape-complete

# SCRAPE_HOOK_SECRET=...   (must match X-Scrape-Secret if you protect the hook)



# One-shot wipe + empty collections (DO NOT put in .env — run in shell only):

#   RESET_DB_CONFIRM=DELETE_ALL_DATA  npm run db:reset



# Google AI Studio (Gemini) — POST /api/analyse (victim hub executive summary + chart JSON)

GOOGLE_AI_API_KEY=

# Optional: GOOGLE_AI_MODEL=gemini-2.5-flash

# Optional: GOOGLE_AI_API_VERSION=v1beta   (default; AI Studio REST). Use v1 only if you accept merged system+user (no top-level systemInstruction).



# Groq — POST /api/live/stream-analytics (NDJSON stream for Live Feed)

GROQ_API_KEY=

# Google Safe Browsing — POST /api/phishing/scan (Phishing URL Scanner page)
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: GROQ_MODEL=llama-3.3-70b-versatile  (on free tier TPM errors, try llama-3.1-8b-instant)

